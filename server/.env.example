# Server-only configuration. Copy this file to server/.env.local and use real local values there.
RESUMETRICS_AI_API_KEY=your_groq_api_key_here
RESUMETRICS_AI_PROVIDER=groq
RESUMETRICS_AI_DEFAULT_MODEL=openai/gpt-oss-20b

# Optional: only needed when the browser is served from a different origin.
RESUMETRICS_WEB_ORIGIN=http://localhost:5173

# GitHub App connection (server-only). Enable “Request user authorization (OAuth)
# during installation” and “Redirect on update” in the GitHub App settings. Its
# Redirect URI must match GITHUB_CALLBACK_URL exactly; the frontend forwards the
# one-time code to the backend so client secrets and tokens stay server-only.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=resumetrics-evidence
GITHUB_CALLBACK_URL=http://localhost:5173/workspace
FRONTEND_URL=http://localhost:5173

# Firebase Admin is required only by the Express backend to verify Firebase ID tokens
# and store GitHub connection metadata in Firestore. Point this to an uncommitted
# Firebase service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional standard Google credential-path alternative to the variable above.
GOOGLE_APPLICATION_CREDENTIALS=
