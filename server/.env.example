# Server-only configuration. Copy this file to server/.env.local and use real local values there.
RESUMETRICS_AI_API_KEY=your_groq_api_key_here
RESUMETRICS_AI_PROVIDER=groq
RESUMETRICS_AI_DEFAULT_MODEL=openai/gpt-oss-20b

# Optional: only needed when the browser is served from a different origin.
RESUMETRICS_WEB_ORIGIN=http://localhost:5173

