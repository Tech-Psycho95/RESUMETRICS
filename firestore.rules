rules_version = '2';

// Browsers never read or write Firestore directly. Every request goes through the Express server
// (server/routes/user.routes.js, github.routes.js), which verifies the Firebase ID token and uses the
// Admin SDK. The Admin SDK bypasses these rules, so this file only closes the door on the client SDK:
// the Firebase web config is public, and without this anyone could script writes to their own documents
// (plan, usage counters, oversized or malformed resumes) and skip the server's validation.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
